          /* Pass <em>True</em> to show the user a button to stop 
          further drafts. The bot will receive an <a 
          href="https://core.telegram.org/bots/api#update">Update</a> 
          “stopped_message_generation” if the user presses the button. */
          canStop         : Option[Boolean]
          /* Pass <em>True</em> to keep the draft in the chat when the 
          button is pressed. The draft will still disappear after a 
          short time or if the bot sends a message. To fully preserve 
          the partial draft, the bot should send it as a new message. */
          keepOnStop      : Option[Boolean]
        } => Method[Boolean]
      
