          messageThreadId         : Option[Int]
          /* Identifier of the direct messages topic to which the 
          message will be forwarded; required if the message is 
          forwarded to a direct messages chat */
          directMessagesTopicId   : Option[Long]
          /* Unique identifier for the chat where the original message 
