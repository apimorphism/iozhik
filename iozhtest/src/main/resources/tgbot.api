          canManageVideoChats     : Option[Boolean]
          /* Pass <em>True</em> if the administrator can restrict, ban 
          or unban chat members, or access supergroup statistics. For 
          backward compatibility, defaults to <em>True</em> for 
          promotions of channel administrators. */
          canRestrictMembers      : Option[Boolean]
