          explicitly allowed by chat administrators. Paid reactions 
          can't be used by bots. */
          reaction  : List[ReactionType]
          /* Pass <em>True</em> to set the reaction with a big animation */
          isBig     : Option[Boolean]
        } => Method[Boolean]
      
        /* Use this method to change the list of the bot's commands. See <a 
